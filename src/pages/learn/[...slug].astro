---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Button } from "../../components/starwind/button";
import PracticeTerminal from "../../components/PracticeTerminal.astro";
import DetailHeader from "../../components/DetailHeader.astro";
import { link } from "../../lib/site";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const lessons = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);
const idx = lessons.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? lessons[idx - 1] : undefined;
const next = idx >= 0 && idx < lessons.length - 1 ? lessons[idx + 1] : undefined;
---

<BaseLayout title={entry.data.title} description={entry.data.summary} current="/learn/">
  <article class="detail container">
    <DetailHeader
      crumb={`${String(entry.data.order).padStart(2, "0")}강`}
      title={entry.data.title}
      summary={entry.data.summary}
      entryId={entry.id}
    />
    <div class="prose">
      <Content />
    </div>
    {
      entry.data.practice && (
        <PracticeTerminal file={entry.data.practiceFile ?? "lesson.md"} title={entry.data.title} />
      )
    }
    <nav class="pager">
      {prev ? <Button as="a" variant="ghost" href={link(`/learn/${prev.id}/`)}>← {prev.data.title}</Button> : <span></span>}
      {next ? <Button as="a" variant="ghost" href={link(`/learn/${next.id}/`)} data-pager-next>{next.data.title} →</Button> : <span></span>}
    </nav>
  </article>
</BaseLayout>
