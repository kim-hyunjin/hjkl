---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryList from "../../components/EntryList.astro";
import { getCollection } from "astro:content";

const curriculum = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="학습하기" current="/learn/">
  <div class="mx-auto w-full max-w-[1080px] px-5 pt-10">
    <EntryList items={curriculum} hrefPrefix="/learn" />
  </div>
</BaseLayout>
