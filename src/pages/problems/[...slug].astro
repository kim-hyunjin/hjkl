---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Button } from "../../components/starwind/button";
import { Collapsible } from "../../components/starwind/collapsible";
import PracticeTerminal from "../../components/PracticeTerminal.astro";
import DetailHeader from "../../components/DetailHeader.astro";
import { link, PROSE_CLASS } from "../../lib/site";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const problems = await getCollection("problems");
  return problems.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const problems = (await getCollection("problems")).sort((a, b) => a.data.order - b.data.order);
const idx = problems.findIndex((p) => p.id === entry.id);
const prev = idx > 0 ? problems[idx - 1] : undefined;
const next = idx >= 0 && idx < problems.length - 1 ? problems[idx + 1] : undefined;

const crumbSuffix = `${String(entry.data.order).padStart(2, "0")}번`;
---

<BaseLayout title={entry.data.title} description={entry.data.summary} current="/">
  <article class="mx-auto w-full max-w-[1080px] px-5">
    <DetailHeader
      crumb={crumbSuffix}
      title={entry.data.title}
      summary={entry.data.summary}
      entryId={entry.id}
      badge={entry.data.difficulty}
    />
    <div class={`${PROSE_CLASS} max-w-[72ch]!`}>
      <Content />
    </div>
    {
      entry.data.practice && (
        <PracticeTerminal
          file={entry.data.practiceFile ?? "problems/problem01.md"}
          title={entry.data.title}
          label="문제 풀기"
        />
      )
    }
    {
      entry.data.answer && (
        <Collapsible.Root>
          <Collapsible.Trigger>정답 확인</Collapsible.Trigger>
          <Collapsible.Panel>
            <pre>{entry.data.answer}</pre>
          </Collapsible.Panel>
        </Collapsible.Root>
      )
    }
    <nav class="mt-12 flex justify-between gap-4 border-t border-border pt-4">
      {
        prev ? (
          <Button as="a" variant="ghost" class="min-w-0 max-w-[calc(50%-0.5rem)]" href={link(`/problems/${prev.id}/`)}>
            <span class="truncate">← {prev.data.title}</span>
          </Button>
        ) : (
          <span></span>
        )
      }
      {
        next ? (
          <Button as="a" variant="ghost" class="min-w-0 max-w-[calc(50%-0.5rem)]" href={link(`/problems/${next.id}/`)} data-pager-next>
            <span class="truncate">{next.data.title} →</span>
          </Button>
        ) : (
          <span></span>
        )
      }
    </nav>
  </article>
</BaseLayout>
