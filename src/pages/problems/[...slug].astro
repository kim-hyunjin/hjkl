---
import { marked } from "marked";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Button } from "../../components/starwind/button";
import { Collapsible } from "../../components/starwind/collapsible";
import ProblemTerminal from "../../components/ProblemTerminal.astro";
import ExpectedResult from "../../components/ExpectedResult.astro";
import DetailHeader from "../../components/DetailHeader.astro";
import { link, PROSE_CLASS } from "../../lib/site";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const problems = await getCollection("problems");
  return problems.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const descriptionHtml = await marked.parse(entry.data.description);

const problems = (await getCollection("problems")).sort((a, b) => a.data.order - b.data.order);
const idx = problems.findIndex((p) => p.id === entry.id);
const prev = idx > 0 ? problems[idx - 1] : undefined;
const next = idx >= 0 && idx < problems.length - 1 ? problems[idx + 1] : undefined;

const crumbSuffix = `${String(entry.data.order).padStart(2, "0")}번`;
---

<BaseLayout title={entry.data.title} description={entry.data.summary} current="/">
  <article class="mx-auto w-full max-w-[1200px] px-5">
    <DetailHeader
      crumb={crumbSuffix}
      title={entry.data.title}
      summary={entry.data.summary}
      entryId={entry.id}
      badge={entry.data.difficulty}
      trackNextComplete={false}
    />
    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
      <div class="flex flex-col gap-6">
        <section>
          <h2 class="mb-3 text-lg font-bold">문제안내</h2>
          <div class={`${PROSE_CLASS} max-w-none`} set:html={descriptionHtml} />
        </section>
        <section>
          <h2 class="mb-3 text-lg font-bold">예상 결과</h2>
          <ExpectedResult text={entry.data.expected} />
        </section>
        <Collapsible.Root>
          <Collapsible.Trigger>힌트 보기</Collapsible.Trigger>
          <Collapsible.Panel>
            <p class="font-mono text-sm">{entry.data.hint}</p>
          </Collapsible.Panel>
        </Collapsible.Root>
      </div>
      <ProblemTerminal
        initialContent={entry.data.initialContent}
        expected={entry.data.expected}
        entryId={entry.id}
        title={entry.data.title}
      />
    </div>
    <nav class="mt-12 flex justify-between gap-4 border-t border-border pt-4">
      {
        prev ? (
          <Button as="a" variant="ghost" class="min-w-0 max-w-[calc(50%-0.5rem)]" href={link(`/problems/${prev.id}/`)}>
            <span class="truncate">← {prev.data.title}</span>
          </Button>
        ) : (
          <span></span>
        )
      }
      {
        next ? (
          <Button as="a" variant="ghost" class="min-w-0 max-w-[calc(50%-0.5rem)]" href={link(`/problems/${next.id}/`)} data-pager-next>
            <span class="truncate">{next.data.title} →</span>
          </Button>
        ) : (
          <span></span>
        )
      }
    </nav>
  </article>
</BaseLayout>
