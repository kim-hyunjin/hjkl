---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProblemTable from "../components/ProblemTable.astro";
import { getCollection } from "astro:content";

const problems = (await getCollection("problems")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="홈" current="/">
  <div class="pt-14 pb-10 max-[760px]:pt-8 max-[760px]:pb-6">
    <div class="mx-auto w-full max-w-[1080px] px-5">
      <h1 class="mb-[0.35rem] text-[clamp(2rem,5vw,3.2rem)]">손끝에서 완성되는 vim</h1>
      <div
        class="my-6 overflow-x-auto rounded-lg border border-border bg-black px-6 py-5 font-mono text-[#d1e7dd] shadow-[0_8px_24px_rgba(0,0,0,0.35)]"
        aria-hidden="true"
      >
        <span class="text-[#6bc46d]">$</span> <span class="text-[#e6edf3]">vim lesson_01.md</span><br />
        <span class="text-[#6b8098]">손끝이 기억하는 순간, 당신은 vim을 배운 것입니다.</span>
      </div>
    </div>
  </div>

  <div class="mx-auto w-full max-w-[1080px] px-5">
    <section>
      <h2 class="text-xl font-bold">문제</h2>
      <p class="text-sm text-muted-foreground mt-1">난이도별로 정리된 문제 목록입니다. 풀어보고 싶은 문제를 골라보세요.</p>
      <ProblemTable items={problems} />
    </section>
  </div>
</BaseLayout>
