---
import { NAV_ITEMS } from "../lib/site";
import { ThemeToggle } from "./starwind/theme-toggle";

interface Props {
  current?: string;
}

const { current = "" } = Astro.props;
const currentPath = current.split("?")[0];
---

<header class="site-header">
  <div class="container">
    <nav class="nav" aria-label="주요 메뉴">
      <a href={NAV_ITEMS[0].href} class="nav-brand" aria-label="hjkl 홈">
        <span class="brand-mark">hjkl</span>
        <span>Vim 학습</span>
      </a>
      <div class="nav-links">
        {
          NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
              class:list={[{ "nav-link-active": currentPath === item.href }]}
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <div class="nav-actions">
        <ThemeToggle ariaLabel="테마 전환" />
      </div>
    </nav>
  </div>
</header>
