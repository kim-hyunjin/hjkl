---
import CollapsiblePrimitive from "@starwind-ui/astro/collapsible";
import type { HTMLAttributes } from "astro/types";

import { collapsibleRoot } from "./variants";

type Props = HTMLAttributes<"div"> & {
  defaultOpen?: boolean;
  disabled?: boolean;
};

const { defaultOpen, disabled, class: className, ...rest } = Astro.props;
---

<CollapsiblePrimitive.Root
  class={collapsibleRoot({ class: className })}
  defaultOpen={defaultOpen}
  disabled={disabled}
  {...rest}
  data-slot="collapsible"
>
  <slot />
</CollapsiblePrimitive.Root>
