---
import TerminalShell from "./TerminalShell.astro";

interface Props {
  /** 실습 파일 경로 (public/practice 기준), 예: "lessons/lesson02.md" */
  file: string;
  /** 랜드마크 이름에 쓰이는 강의·문제 제목 */
  title?: string;
  label?: string;
}

const { file, title = "vim 연습장", label = "실습" } = Astro.props;
---

<TerminalShell title={title} label={label} fileName={file} rootAttrs={{ "data-practice-terminal": "", "data-file": file }} />

<script>
  import { createVimEditorView, registerTerminalState, setStatus, assertVimAttached, type BaseTerminalState } from "../scripts/vim-editor";
  import type { EditorView } from "codemirror";

  const BASE = import.meta.env.BASE_URL ?? "/";

  interface TerminalState extends BaseTerminalState {}

  async function loadFile(st: TerminalState, view: EditorView, name: string) {
    setStatus(st, "파일 로드 중…", "loading");
    st.fileName = name;
    let content = "// hjkl 실습 파일\n// vim으로 편집해보세요.\n\n";
    try {
      const res = await fetch(`${BASE}practice/${name}`);
      if (res.ok) content = await res.text();
    } catch {}
    view.dispatch({
      changes: { from: 0, to: view.state.doc.length, insert: content },
      selection: { anchor: 0 },
    });
    st.originalContent = content;
    st.savedContent = content;
    setStatus(st, `로드됨: ${name}`, "ready");
    view.focus();
  }

  async function initTerminal(root: HTMLElement) {
    const host = root.querySelector<HTMLElement>(".practice-editor");
    const statusEl = root.querySelector<HTMLElement>("[data-practice-status]");
    if (!host || !statusEl) return;

    const fileName = root.dataset.file || "lesson01.md";

    const view = createVimEditorView(host, "");

    const st = registerTerminalState<TerminalState>(view, {
      fileName,
      originalContent: "",
      savedContent: "",
      statusEl,
      mimeType: "text/markdown;charset=utf-8",
    });
    if (!assertVimAttached(view, (message) => setStatus(st, message, "error"))) return;
    await loadFile(st, view, fileName);
  }

  document.querySelectorAll("[data-practice-terminal]").forEach((el) => initTerminal(el as HTMLElement));
</script>
