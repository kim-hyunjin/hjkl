---
interface Props {
  /** 실습 파일 경로 (public/practice 기준), 예: "problems/problem05.md" */
  file: string;
  /** 랜드마크 이름에 쓰이는 강의·문제 제목 */
  title?: string;
  label?: string;
}

const { file, title = "vim 연습장", label = "실습" } = Astro.props;
---

<section class="mt-8" aria-label={`${title} ${label}`}>
  <h2 class="mb-3 text-lg font-bold">{label}</h2>

  <div class="overflow-hidden rounded-lg border border-border bg-black shadow-[0_8px_24px_rgba(0,0,0,0.35)]" data-practice-terminal data-file={file}>
    <div class="flex items-center gap-2 border-b border-border bg-muted px-3.5 py-2 font-mono text-xs text-muted-foreground">
      <span class="size-[11px] rounded-full bg-[#f85149]"></span>
      <span class="size-[11px] rounded-full bg-[#d29922]"></span>
      <span class="size-[11px] rounded-full bg-[#3fb950]"></span>
      <span class="ml-1">{file}</span>
    </div>
    <div class="relative h-[480px] overflow-hidden max-[760px]:h-80">
      <div class="practice-editor h-full"></div>
    </div>
    <div class="flex items-center justify-between gap-3 border-t border-border bg-muted px-3.5 py-1.5 font-mono text-xs text-muted-foreground">
      <span class="truncate">{file}</span>
      <span
        class="shrink-0 data-[kind=loading]:text-warning data-[kind=ready]:text-success data-[kind=error]:text-error"
        data-practice-status
      >초기화 중</span>
    </div>
  </div>
</section>

<script>
  import { basicSetup, EditorView } from "codemirror";
  import { vim, Vim, getCM, type CodeMirror } from "@replit/codemirror-vim";

  const BASE = import.meta.env.BASE_URL ?? "/";

  interface TerminalState {
    fileName: string;
    originalContent: string;
    savedContent: string;
    statusEl: HTMLElement;
  }

  const terminalStates = new Map<EditorView, TerminalState>();

  function downloadFile(name: string, content: string) {
    const blob = new Blob([content], { type: "text/markdown;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  const setStatus = (st: TerminalState, text: string, kind: "idle" | "loading" | "ready" | "error" | "done" = "idle") => {
    st.statusEl.textContent = text;
    st.statusEl.dataset.kind = kind;
  };

  function stateOf(cm: CodeMirror): TerminalState | undefined {
    const view = (cm as any).cm6 as EditorView | undefined;
    return view ? terminalStates.get(view) : undefined;
  }

  function saveWith(cm: CodeMirror, argString: string | undefined, message: (name: string) => string) {
    const st = stateOf(cm);
    if (!st) return;
    const name = argString?.trim().split(/\s+/)[0] || st.fileName;
    downloadFile(name, cm.getValue());
    st.savedContent = cm.getValue();
    setStatus(st, message(name), "done");
  }

  Vim.defineEx("write", "w", (cm, params) => saveWith(cm, params.argString, (n) => `저장됨: ${n}`));
  Vim.defineEx("wq", "wq", (cm, params) => saveWith(cm, params.argString, (n) => `저장 후 종료: ${n}`));
  Vim.defineEx("xit", "x", (cm, params) => saveWith(cm, params.argString, (n) => `저장 후 종료: ${n}`));

  Vim.defineEx("quit", "q", (cm, params) => {
    const st = stateOf(cm);
    if (!st) return;
    if (params.args?.includes("!")) {
      cm.setValue(st.originalContent);
      st.savedContent = st.originalContent;
      setStatus(st, "종료됨 (변경 사항 버림)", "done");
      return;
    }
    if (cm.getValue() !== st.savedContent) {
      setStatus(st, "E37: 저장되지 않은 변경 사항이 있습니다 (:q! 로 강제 종료)", "error");
    } else {
      setStatus(st, "종료됨", "done");
    }
  });

  Vim.mapCommand("ZZ", "keyToEx", "", undefined, { exArgs: { input: "wq" } });

  // 라이브러리 기본값은 pcre(JavaScript 정규식)라 강의에서 가르치는 vim 정규식
  // (`\<단어\>`, `\+`, `\(...\)`, `\v` 등)이 그대로 동작하지 않는다. vim 문법으로 맞춘다.
  Vim.setOption("pcre", false);

  // Normal/Visual 모드에서 DOM으로 직접 들어오는 입력을 무시한다.
  // 키 이벤트는 vim 키맵이 가로채지만 일부 DOM 입력은 keydown 없이 도착해 vim
  // 키맵을 지나치므로, Normal 모드인데도 글자가 삽입될 수 있다. vim 명령이 만드는
  // 편집은 view.dispatch로 들어와 이 핸들러를 타지 않는다.
  //
  // 주의: @replit/codemirror-vim은 IME 조합을 vim 키 입력으로 변환하는 자체
  // inputHandler를 갖고 있다(라이브러리 소스의 `useNextTextInput` 처리, forceEndComposition
  // 참고). extensions 배열에서 이 가드를 vim() 뒤에 둬야 한다 — CM6는 inputHandler들을
  // 등록 순서대로 .some()으로 실행해 먼저 true를 반환한 쪽에서 멈추므로, 이 가드가 먼저
  // 오면 라이브러리의 조합 처리 로직이 아예 실행되지 못한다.
  const blockInputOutsideInsertMode = EditorView.inputHandler.of((view) => {
    const vimState = getCM(view)?.state?.vim;
    return !!vimState && !vimState.insertMode;
  });

  // CodeMirror가 런타임에 만드는 DOM은 Astro의 스코프 CSS(`data-astro-cid-*`)가 닿지 않으므로
  // 레이아웃·폰트까지 전부 여기서 준다. height 100%가 빠지면 에디터가 내용 높이(2~3줄)만큼만
  // 차지해서, 480px 컨테이너의 나머지가 클릭해도 반응하지 않는 죽은 영역이 된다.
  const theme = EditorView.theme({
    "&": { height: "100%", fontSize: "15px", background: "#0d1117", color: "#c9d1d9" },
    "&.cm-focused": { outline: "none" },
    ".cm-scroller": { fontFamily: '"SFMono-Regular", ui-monospace, Menlo, monospace', lineHeight: "1.6" },
    ".cm-content": { caretColor: "#f0f6fc" },
    ".cm-cursor, .cm-dropCursor": { borderLeftColor: "#f0f6fc" },
    ".cm-selectionBackground, &.cm-focused .cm-selectionBackground, & ::selection": { backgroundColor: "#264f78 !important" },
    ".cm-activeLine": { backgroundColor: "rgba(110,118,129,0.12)" },
    ".cm-activeLineGutter": { backgroundColor: "rgba(110,118,129,0.12)" },
    ".cm-gutters": { background: "#0d1117", color: "#8b949e", border: "none" },
    ".cm-lineNumbers .cm-gutterElement": { padding: "0 8px 0 12px" },
    ".cm-searchMatch": { outline: "1px solid #f0c674 !important", background: "transparent" },
    ".cm-vim-panel": {
      background: "#161b22",
      borderTop: "1px solid #30363d",
      color: "#8b949e",
      padding: "2px 10px",
      minHeight: "1.5em",
    },
  });

  async function loadFile(st: TerminalState, view: EditorView, name: string) {
    setStatus(st, "파일 로드 중…", "loading");
    st.fileName = name;
    let content = "// hjkl 실습 파일\n// vim으로 편집해보세요.\n\n";
    try {
      const res = await fetch(`${BASE}practice/${name}`);
      if (res.ok) content = await res.text();
    } catch {}
    view.dispatch({
      changes: { from: 0, to: view.state.doc.length, insert: content },
      selection: { anchor: 0 },
    });
    st.originalContent = content;
    st.savedContent = content;
    setStatus(st, `로드됨: ${name}`, "ready");
    view.focus();
  }

  async function initTerminal(root: HTMLElement) {
    const host = root.querySelector<HTMLElement>(".practice-editor");
    const statusEl = root.querySelector<HTMLElement>("[data-practice-status]");
    if (!host || !statusEl) return;

    const fileName = root.dataset.file || "lesson01.md";

    const view = new EditorView({
      doc: "",
      extensions: [vim({ status: true }), blockInputOutsideInsertMode, basicSetup, EditorView.lineWrapping, theme],
      parent: host,
    });

    const st: TerminalState = { fileName, originalContent: "", savedContent: "", statusEl };
    terminalStates.set(view, st);
    await loadFile(st, view, fileName);
  }

  document.querySelectorAll("[data-practice-terminal]").forEach((el) => initTerminal(el as HTMLElement));
</script>

