---
import "@fontsource/jetbrains-mono/400.css";

interface Props {
  /** 실습 파일 경로 (public/practice 기준), 예: "lessons/lesson02.md" */
  file: string;
  /** 랜드마크 이름에 쓰이는 강의·문제 제목 */
  title?: string;
  label?: string;
}

const { file, title = "vim 연습장", label = "실습" } = Astro.props;
---

<section class="mt-8" aria-label={`${title} ${label}`}>
  <h2 class="mb-3 text-lg font-bold">{label}</h2>

  <div class="overflow-hidden rounded-lg border border-border bg-black shadow-[0_8px_24px_rgba(0,0,0,0.35)]" data-practice-terminal data-file={file}>
    <div class="flex items-center gap-2 border-b border-border bg-muted px-3.5 py-2 font-mono text-xs text-muted-foreground">
      <span class="size-[11px] rounded-full bg-[#f85149]"></span>
      <span class="size-[11px] rounded-full bg-[#d29922]"></span>
      <span class="size-[11px] rounded-full bg-[#3fb950]"></span>
      <span class="ml-1">{file}</span>
    </div>
    <div class="relative h-[480px] overflow-hidden max-[760px]:h-80">
      <div class="practice-editor h-full"></div>
    </div>
    <div class="flex items-center justify-between gap-3 border-t border-border bg-muted px-3.5 py-1.5 font-mono text-xs text-muted-foreground">
      <span class="truncate">{file}</span>
      <span
        class="shrink-0 data-[kind=loading]:text-warning data-[kind=ready]:text-success data-[kind=error]:text-error"
        data-practice-status
      >초기화 중</span>
    </div>
  </div>
</section>

<script>
  import { basicSetup, EditorView } from "codemirror";
  import { vim, Vim, getCM, type CodeMirror } from "@replit/codemirror-vim";

  const BASE = import.meta.env.BASE_URL ?? "/";

  interface TerminalState {
    fileName: string;
    originalContent: string;
    savedContent: string;
    statusEl: HTMLElement;
  }

  const terminalStates = new Map<EditorView, TerminalState>();

  function downloadFile(name: string, content: string) {
    const blob = new Blob([content], { type: "text/markdown;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  const setStatus = (st: TerminalState, text: string, kind: "idle" | "loading" | "ready" | "error" | "done" = "idle") => {
    st.statusEl.textContent = text;
    st.statusEl.dataset.kind = kind;
  };

  function stateOf(cm: CodeMirror): TerminalState | undefined {
    const view = (cm as any).cm6 as EditorView | undefined;
    return view ? terminalStates.get(view) : undefined;
  }

  function saveWith(cm: CodeMirror, argString: string | undefined, message: (name: string) => string) {
    const st = stateOf(cm);
    if (!st) return;
    const name = argString?.trim().split(/\s+/)[0] || st.fileName;
    downloadFile(name, cm.getValue());
    st.savedContent = cm.getValue();
    setStatus(st, message(name), "done");
  }

  Vim.defineEx("write", "w", (cm, params) => saveWith(cm, params.argString, (n) => `저장됨: ${n}`));
  Vim.defineEx("wq", "wq", (cm, params) => saveWith(cm, params.argString, (n) => `저장 후 종료: ${n}`));
  Vim.defineEx("xit", "x", (cm, params) => saveWith(cm, params.argString, (n) => `저장 후 종료: ${n}`));

  Vim.defineEx("quit", "q", (cm, params) => {
    const st = stateOf(cm);
    if (!st) return;
    if (params.args?.includes("!")) {
      cm.setValue(st.originalContent);
      st.savedContent = st.originalContent;
      setStatus(st, "종료됨 (변경 사항 버림)", "done");
      return;
    }
    if (cm.getValue() !== st.savedContent) {
      setStatus(st, "E37: 저장되지 않은 변경 사항이 있습니다 (:q! 로 강제 종료)", "error");
    } else {
      setStatus(st, "종료됨", "done");
    }
  });

  Vim.mapCommand("ZZ", "keyToEx", "", undefined, { exArgs: { input: "wq" } });

  // 시스템 클립보드 레지스터(`"+`)의 붙여넣기를 고친다.
  //
  // 라이브러리(vim-core의 actions.paste)는 `"+p`에서 navigator.clipboard.readText()를
  // 그대로 호출하고 결과를 기다리기만 한다. 그런데 브라우저에서 이 API는
  //  - Chrome: 읽기 권한이 필요하고, 권한 프롬프트에 응답이 없으면 promise가 영영
  //    pending으로 남는다 → `"+p`가 아무 일도 일어나지 않은 채 끝난다
  //  - Firefox/Safari: 웹 페이지에 readText가 아예 없다 → 호출 자체가 실패한다
  // 어느 쪽이든 실패가 사용자에게 전혀 보이지 않는다. 그래서 기다림에 시간 제한을 두고,
  // 못 읽으면 에디터가 들고 있는 `+` 레지스터 사본으로 붙여넣은 뒤 상태줄로 알린다.
  //
  // 복사(`"+y`)는 원래 동작한다. 라이브러리가 레지스터와 OS 클립보드에 함께 쓰고,
  // writeText는 키 입력의 user activation 덕에 권한 없이도 성공한다. 그래서 이 사이트
  // 안에서의 `"+y` → `"+p`는 클립보드 권한이 없어도 항상 제대로 동작하게 된다.
  const CLIPBOARD_READ_TIMEOUT_MS = 500;

  function readSystemClipboard(): Promise<string | null> {
    const clipboard = navigator.clipboard;
    if (!clipboard?.readText) return Promise.resolve(null);
    let pending: Promise<string>;
    try {
      pending = clipboard.readText();
    } catch {
      return Promise.resolve(null);
    }
    return Promise.race([
      pending.catch(() => null),
      new Promise<null>((resolve) => setTimeout(() => resolve(null), CLIPBOARD_READ_TIMEOUT_MS)),
    ]);
  }

  // this는 라이브러리의 actions 객체다(actions[command.action](...)로 호출된다).
  // 붙여넣기 본체인 continuePaste는 거기 들어 있어서 그대로 위임한다.
  Vim.defineAction("paste", function (this: any, cm, actionArgs, vim) {
    const actions = this;
    const register = Vim.getRegisterController().getRegister(actionArgs.registerName);

    if (actionArgs.registerName !== "+") {
      actions.continuePaste(cm, actionArgs, vim, register.toString(), register);
      return;
    }

    readSystemClipboard().then((clipboardText) => {
      if (clipboardText) {
        actions.continuePaste(cm, actionArgs, vim, clipboardText, register);
        return;
      }
      const ownCopy = register.toString();
      const st = stateOf(cm as unknown as CodeMirror);
      if (st) {
        setStatus(
          st,
          ownCopy
            ? '시스템 클립보드를 읽을 수 없어 에디터 안의 "+ 레지스터를 붙여넣었습니다'
            : '시스템 클립보드를 읽을 수 없습니다 ("+y로 먼저 복사해보세요)',
        );
      }
      if (ownCopy) actions.continuePaste(cm, actionArgs, vim, ownCopy, register);
    });
  });

  // 라이브러리 기본값은 pcre(JavaScript 정규식)라 강의에서 가르치는 vim 정규식
  // (`\<단어\>`, `\+`, `\(...\)`, `\v` 등)이 그대로 동작하지 않는다. vim 문법으로 맞춘다.
  Vim.setOption("pcre", false);

  // vim이 아직 붙지 않았으면(초기화 전) 아무것도 막지 않는다.
  function outsideInsertMode(view: EditorView) {
    const vimState = getCM(view)?.state?.vim;
    return !!vimState && !vimState.insertMode;
  }

  // Normal/Visual 모드에서 DOM으로 직접 들어오는 입력을 무시한다.
  // 키 이벤트는 vim 키맵이 가로채지만 일부 DOM 입력은 keydown 없이 도착해 vim
  // 키맵을 지나치므로, Normal 모드인데도 글자가 삽입될 수 있다. vim 명령이 만드는
  // 편집은 view.dispatch로 들어와 이 핸들러들을 타지 않는다.
  //
  // 1단계: 브라우저가 편집 영역을 고치기 전에 beforeinput을 취소한다. inputHandler는
  // 브라우저가 이미 글자를 넣은 뒤에 불리므로, 그것만으로는 글자가 한 번 화면에 그려지는
  // 것 자체를 막을 수 없다. 여기서 취소하면 애초에 DOM에 들어오지 않는다.
  const blockBeforeInputOutsideInsertMode = EditorView.domEventHandlers({
    // 취소할 수 없는 이벤트(IME 조합 중에 오는 insertCompositionText)까지 true를 반환하면
    // CodeMirror의 beforeinput 처리만 건너뛸 뿐 입력은 그대로 들어온다. 그건 2단계가 맡는다.
    beforeinput: (event, view) => event.cancelable && outsideInsertMode(view),
  });

  // 2단계: 그래도 들어온 입력(취소할 수 없는 조합 입력)은 문서에 반영하지 않는다.
  //
  // 주의: @replit/codemirror-vim은 IME 조합을 vim 키 입력으로 변환하는 자체
  // inputHandler를 갖고 있다(라이브러리 소스의 `useNextTextInput` 처리, forceEndComposition
  // 참고). extensions 배열에서 이 가드를 vim() 뒤에 둬야 한다 — CM6는 inputHandler들을
  // 등록 순서대로 .some()으로 실행해 먼저 true를 반환한 쪽에서 멈추므로, 이 가드가 먼저
  // 오면 라이브러리의 조합 처리 로직이 아예 실행되지 못한다.
  const blockInputOutsideInsertMode = EditorView.inputHandler.of((view) => {
    if (!outsideInsertMode(view)) return false;
    // 조합 중에는 CodeMirror가 화면에 그려진 조합 문자를 일부러 남겨둔다(DocView.update가
    // 조합 범위는 다시 그리지 않는다). 그래서 입력을 무시하기만 하면 글자가 화면에 남아
    // 있다가, IME가 조합을 끝낼 때(다음 키 입력이나 IME 타임아웃) 뒤늦게야 사라진다.
    // 조합을 먼저 끝내고 화면을 문서 상태대로 다시 그려서 곧바로 지운다.
    if (view.compositionStarted) {
      view.contentDOM.dispatchEvent(new CompositionEvent("compositionend"));
      Promise.resolve().then(() => {
        if (view.dom.isConnected) view.update([]);
      });
    }
    return true;
  });

  // 3단계(가장 확실한 방어선): Normal/Visual 모드에서는 편집 영역의 contenteditable을 꺼 둔다.
  //
  // 1·2단계만으로 부족한 이유: vim 키맵은 "자기가 처리한" 키의 keydown에만
  // preventDefault를 건다(라이브러리 handleKey는 result가 참일 때만 막는다). 그래서 vim이
  // 처리하지 못한 키는 keydown이 막히지 않은 채 브라우저의 기본 문자 삽입 경로로 흘러간다.
  // 단일 키는 대부분 vim이 가져가지만, `@7`·`Vp`처럼 두 번째 키에서 처리에 실패하는 조합이
  // 실제로 존재한다(vim을 배우는 중이라면 이런 어중간한 조합을 수시로 누르게 된다).
  // 그 뒤를 beforeinput 취소에만 의존하는 건 위태롭다 — 취소 가능 여부와 취소가 실제로
  // 먹히는지는 브라우저·입력기마다 다르고, IME 조합이 만드는 insertCompositionText는
  // 애초에 취소할 수 없는 이벤트다.
  //
  // contenteditable이 꺼져 있으면 브라우저가 이 영역을 편집 대상으로 보지 않으므로 기본
  // 삽입 경로도, IME 조합 자체도 시작되지 않는다. 즉 막아야 할 입력이 만들어지지 않는다.
  // vim 명령이 만드는 편집은 view.dispatch로 들어오므로 영향을 받지 않는다.
  //
  // EditorView.editable 대신 contentAttributes로 속성만 덮어쓰는 이유: editable 파셋을
  // 끄면 CodeMirror가 선택 영역 그리기·포커스 처리·마우스 선택까지 다르게 동작한다.
  // 여기서 닫고 싶은 건 브라우저의 편집 경로 하나뿐이라 DOM 속성만 바꾼다.
  // contenteditable이 아닌 요소는 기본적으로 포커스를 받지 못하므로 tabindex를 함께 준다.
  const editableOnlyInInsertMode = EditorView.contentAttributes.of((view) => ({
    contenteditable: outsideInsertMode(view) ? "false" : "true",
    tabindex: "0",
  }));

  // 위 속성은 CodeMirror가 뷰를 갱신할 때 다시 계산된다. 모드 전환 직후 바로 반영되도록
  // 빈 트랜잭션을 흘려보낸다. vim-mode-change는 cm.operation() 안에서 발생하므로 진행 중인
  // 업데이트에 끼어들지 않게 마이크로태스크로 미룬다(사람이 그 사이에 키를 누를 수는 없다).
  function syncEditableWithVimMode(view: EditorView) {
    const cm = getCM(view);
    if (!cm) return;
    cm.on("vim-mode-change", () => {
      Promise.resolve().then(() => {
        if (!view.dom.isConnected) return;
        const hadFocus = view.hasFocus;
        view.dispatch({});
        // contenteditable이 꺼지는 순간 포커스를 놓는 브라우저가 있어 되돌려준다.
        if (hadFocus && !view.hasFocus) view.focus();
      });
    });
  }

  // CodeMirror가 런타임에 만드는 DOM은 Astro의 스코프 CSS(`data-astro-cid-*`)가 닿지 않으므로
  // 레이아웃·폰트까지 전부 여기서 준다. height 100%가 빠지면 에디터가 내용 높이(2~3줄)만큼만
  // 차지해서, 480px 컨테이너의 나머지가 클릭해도 반응하지 않는 죽은 영역이 된다.
  const theme = EditorView.theme({
    "&": { height: "100%", fontSize: "15px", background: "#0d1117", color: "#c9d1d9" },
    "&.cm-focused": { outline: "none" },
    // Normal 모드 블록 커서는 빈 줄에서 채울 문자가 없으면 NBSP(U+00A0)를 그 자리에
    // 그려 넣는다(라이브러리 내부 동작, 커서 폭을 유지하기 위함). 이 글자의 실제
    // 렌더링은 폰트에 달려 있어서, OS 시스템 폰트에 기대면(SFMono/Menlo는 macOS
    // 전용이라 다른 OS에서는 임의의 monospace로 대체된다) 일부 폰트에서 그 자리에
    // 점·상자 같은 게 보일 수 있다. 웹폰트를 번들해 항상 같은 폰트로 렌더링한다.
    ".cm-scroller": { fontFamily: '"JetBrains Mono", "SFMono-Regular", ui-monospace, Menlo, monospace', lineHeight: "1.6" },
    ".cm-content": { caretColor: "#f0f6fc" },
    ".cm-cursor, .cm-dropCursor": { borderLeftColor: "#f0f6fc" },
    ".cm-selectionBackground, &.cm-focused .cm-selectionBackground, & ::selection": { backgroundColor: "#264f78 !important" },
    ".cm-activeLine": { backgroundColor: "rgba(110,118,129,0.12)" },
    ".cm-activeLineGutter": { backgroundColor: "rgba(110,118,129,0.12)" },
    ".cm-gutters": { background: "#0d1117", color: "#8b949e", border: "none" },
    ".cm-lineNumbers .cm-gutterElement": { padding: "0 8px 0 12px" },
    ".cm-searchMatch": { outline: "1px solid #f0c674 !important", background: "transparent" },
    ".cm-vim-panel": {
      background: "#161b22",
      borderTop: "1px solid #30363d",
      color: "#8b949e",
      padding: "2px 10px",
      minHeight: "1.5em",
    },
  });

  async function loadFile(st: TerminalState, view: EditorView, name: string) {
    setStatus(st, "파일 로드 중…", "loading");
    st.fileName = name;
    let content = "// hjkl 실습 파일\n// vim으로 편집해보세요.\n\n";
    try {
      const res = await fetch(`${BASE}practice/${name}`);
      if (res.ok) content = await res.text();
    } catch {}
    view.dispatch({
      changes: { from: 0, to: view.state.doc.length, insert: content },
      selection: { anchor: 0 },
    });
    st.originalContent = content;
    st.savedContent = content;
    setStatus(st, `로드됨: ${name}`, "ready");
    view.focus();
  }

  async function initTerminal(root: HTMLElement) {
    const host = root.querySelector<HTMLElement>(".practice-editor");
    const statusEl = root.querySelector<HTMLElement>("[data-practice-status]");
    if (!host || !statusEl) return;

    const fileName = root.dataset.file || "lesson01.md";

    const view = new EditorView({
      doc: "",
      extensions: [
        vim({ status: true }),
        editableOnlyInInsertMode,
        blockBeforeInputOutsideInsertMode,
        blockInputOutsideInsertMode,
        basicSetup,
        EditorView.lineWrapping,
        theme,
      ],
      parent: host,
    });

    syncEditableWithVimMode(view);

    const st: TerminalState = { fileName, originalContent: "", savedContent: "", statusEl };
    terminalStates.set(view, st);
    await loadFile(st, view, fileName);
  }

  document.querySelectorAll("[data-practice-terminal]").forEach((el) => initTerminal(el as HTMLElement));
</script>

