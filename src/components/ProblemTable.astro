---
import { link } from "../lib/site";
import { Badge } from "./starwind/badge";
import { Input } from "./starwind/input";
import { NativeSelect, NativeSelectOption } from "./starwind/native-select";
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from "./starwind/table";
import type { CollectionEntry } from "astro:content";

interface Props {
  items: CollectionEntry<"problems">[];
}

const { items } = Astro.props;

const difficultyOrder = ["입문", "초급", "중급", "고급"];

const rows = items.map((entry, i) => {
  const difficulty = entry.data.difficulty;
  return {
    entry,
    difficulty,
    difficultyRank: difficultyOrder.indexOf(difficulty),
    searchText: [entry.data.title, entry.data.summary, ...entry.data.tags].join(" ").toLowerCase(),
    index: i,
  };
});

const difficulties = difficultyOrder.filter((d) => rows.some((r) => r.difficulty === d));
---

<div class="problem-toolbar">
  <Input
    id="problem-search"
    type="search"
    size="sm"
    placeholder="제목·태그 검색"
    aria-label="문제 검색"
    class="flex-1 min-w-56"
  />
  <NativeSelect id="problem-filter-difficulty" size="sm" aria-label="난이도 필터">
    <NativeSelectOption value="">난이도 전체</NativeSelectOption>
    {difficulties.map((d) => <NativeSelectOption value={d}>{d}</NativeSelectOption>)}
  </NativeSelect>
  <NativeSelect id="problem-filter-status" size="sm" aria-label="완료 상태 필터">
    <NativeSelectOption value="">완료 상태 전체</NativeSelectOption>
    <NativeSelectOption value="done">완료</NativeSelectOption>
    <NativeSelectOption value="undone">미완료</NativeSelectOption>
  </NativeSelect>
  <NativeSelect id="problem-sort" size="sm" aria-label="정렬 기준">
    <NativeSelectOption value="default">기본순</NativeSelectOption>
    <NativeSelectOption value="title">제목순</NativeSelectOption>
    <NativeSelectOption value="difficulty">난이도순</NativeSelectOption>
  </NativeSelect>
</div>

<div class="problem-table-wrap">
  <Table>
    <TableHeader>
      <TableRow>
        <TableHead class="w-[1%] text-center">상태</TableHead>
        <TableHead class="w-[1%] text-center">번호</TableHead>
        <TableHead>제목</TableHead>
        <TableHead class="w-[1%]">난이도</TableHead>
        <TableHead class="w-[1%]">태그</TableHead>
      </TableRow>
    </TableHeader>
    <TableBody id="problem-tbody">
      {
        rows.map(({ entry, difficulty, difficultyRank, searchText, index }) => (
          <TableRow
            data-difficulty={difficulty}
            data-difficulty-rank={difficultyRank}
            data-title={entry.data.title.toLowerCase()}
            data-search={searchText}
            data-order-idx={index}
          >
            <TableCell class="text-center">
              <span class="status-dot" data-complete={entry.id} aria-label="완료 여부" />
            </TableCell>
            <TableCell class="text-center">{String(index + 1).padStart(2, "0")}</TableCell>
            <TableCell class="whitespace-normal">
              <a class="problem-link" href={link(`/problems/${entry.id}/`)}>
                {entry.data.title}
              </a>
              <p class="problem-summary">{entry.data.summary}</p>
            </TableCell>
            <TableCell>
              <Badge variant="outline" class="border-primary text-primary">
                {difficulty}
              </Badge>
            </TableCell>
            <TableCell class="whitespace-normal">
              <div class="tag-list">
                {entry.data.tags.map((tag) => (
                  <Badge tone="neutral" appearance="soft" size="sm">
                    {tag}
                  </Badge>
                ))}
              </div>
            </TableCell>
          </TableRow>
        ))
      }
    </TableBody>
  </Table>
  <p class="problem-noresult" id="problem-noresult" hidden>조건에 맞는 문제가 없습니다.</p>
</div>

<script>
  import { readCompleted } from "../scripts/progress";

  const tbody = document.getElementById("problem-tbody");
  const noResult = document.getElementById("problem-noresult");
  const searchInput = document.getElementById("problem-search") as HTMLInputElement | null;
  const difficultySelect = document.getElementById("problem-filter-difficulty") as HTMLSelectElement | null;
  const statusSelect = document.getElementById("problem-filter-status") as HTMLSelectElement | null;
  const sortSelect = document.getElementById("problem-sort") as HTMLSelectElement | null;

  const rows = tbody ? Array.from(tbody.querySelectorAll<HTMLTableRowElement>("tr")) : [];

  const refreshStatus = () => {
    const completed = readCompleted();
    for (const row of rows) {
      const dot = row.querySelector<HTMLElement>("[data-complete]");
      const id = dot?.dataset.complete || "";
      const isDone = completed.has(id);
      dot?.classList.toggle("is-done", isDone);
      row.dataset.done = isDone ? "1" : "0";
    }
  };

  const applySort = () => {
    if (!tbody || !sortSelect) return;
    const mode = sortSelect.value;
    const sorted = [...rows].sort((a, b) => {
      if (mode === "title") {
        return (a.dataset.title || "").localeCompare(b.dataset.title || "", "ko");
      }
      if (mode === "difficulty") {
        const diff = Number(a.dataset.difficultyRank) - Number(b.dataset.difficultyRank);
        if (diff !== 0) return diff;
      }
      return Number(a.dataset.orderIdx) - Number(b.dataset.orderIdx);
    });
    for (const row of sorted) tbody.appendChild(row);
  };

  const applyFilter = () => {
    const query = (searchInput?.value || "").trim().toLowerCase();
    const difficulty = difficultySelect?.value || "";
    const status = statusSelect?.value || "";
    let visibleCount = 0;
    for (const row of rows) {
      const matchesDifficulty = !difficulty || row.dataset.difficulty === difficulty;
      const matchesStatus = !status || (status === "done" ? row.dataset.done === "1" : row.dataset.done === "0");
      const matchesQuery = !query || (row.dataset.search || "").includes(query);
      const visible = matchesDifficulty && matchesStatus && matchesQuery;
      row.style.display = visible ? "" : "none";
      if (visible) visibleCount++;
    }
    if (noResult) noResult.hidden = visibleCount > 0;
  };

  const refreshAll = () => {
    refreshStatus();
    applySort();
    applyFilter();
  };

  searchInput?.addEventListener("input", applyFilter);
  difficultySelect?.addEventListener("change", applyFilter);
  statusSelect?.addEventListener("change", applyFilter);
  sortSelect?.addEventListener("change", applySort);
  window.addEventListener("hjkl:progress", refreshAll);

  refreshAll();
</script>

<style>
  .problem-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .problem-table-wrap {
    margin-top: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .status-dot {
    display: inline-block;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px;
    border: 2px solid var(--border);
  }

  .status-dot.is-done {
    border-color: var(--primary);
    background: var(--primary);
  }

  .problem-link {
    font-weight: 600;
    color: var(--foreground);
  }

  .problem-summary {
    margin: 0.15rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.85rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .problem-noresult {
    margin: 0;
    padding: 1.5rem 1rem;
    text-align: center;
    color: var(--muted-foreground);
  }
</style>
