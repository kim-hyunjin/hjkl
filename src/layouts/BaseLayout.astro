---
import "@/styles/starwind.css";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const {
  title,
  description = "Vim을 기초부터 실전까지 배우는 한국어 학습 사이트",
  current = "",
} = Astro.props;

const fullTitle = title === "홈" ? "hjkl — Vim 학습 사이트" : `${title} | hjkl`;
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "favicon.svg"} />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.ico"} />
    <title>{fullTitle}</title>
    <ThemeInitScript />
  </head>
  <body class="min-h-screen font-sans text-base leading-[1.6]">
    <a
      class="absolute top-[-100%] left-4 z-100 rounded-lg bg-primary px-4 py-2 font-semibold text-primary-foreground focus:top-2"
      href="#main">본문으로 건너뛰기</a>
    <Header current={current} />
    <main id="main" class="pb-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
